# Copy to ~/.hermes/.env (or set these with `hermes config set NAME value`).
# Only the two bot tokens are required; everything else has a sane default.

# ── Bale (https://docs.bale.ai) ─────────────────────────────────────────────
BALE_BOT_TOKEN=
BALE_ALLOWED_USERS=
# BALE_ALLOW_ALL_USERS=false
# BALE_HOME_CHANNEL=
# BALE_HOME_CHANNEL_NAME=
# BALE_API_BASE=https://tapi.bale.ai
# BALE_MARKDOWN=false
# BALE_POLL_TIMEOUT=25
# BALE_MAX_MESSAGE_LENGTH=4096

# ── Rubika (https://rubika.ir/botapi) ───────────────────────────────────────
RUBIKA_BOT_TOKEN=
RUBIKA_ALLOWED_USERS=
# RUBIKA_ALLOW_ALL_USERS=false
# RUBIKA_HOME_CHANNEL=
# RUBIKA_HOME_CHANNEL_NAME=
# RUBIKA_API_BASE=https://botapi.rubika.ir/v3
# RUBIKA_POLL_INTERVAL=3
# RUBIKA_INTERACTIVE=true
# RUBIKA_MAX_MESSAGE_LENGTH=4096
